<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Play triangle (8,5)→(8,19)→(19,12) is split into two 4-point shapes:
        - leftShape: trapezoid covering the left half of the triangle
        - rightShape: degenerate quad (triangle) covering the right tip
        Both morph into the two pause bars.
    -->
    <path
        android:name="leftShape"
        android:fillColor="#FF000000"
        android:pathData="M 8,5 L 13,8 L 13,16 L 8,19 Z" />
    <path
        android:name="rightShape"
        android:fillColor="#FF000000"
        android:pathData="M 13,8 L 19,12 L 19,12 L 13,16 Z" />
</vector>
